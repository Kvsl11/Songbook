{
  // Terminal → Executar tarefa → "Ligar o servidor da IA (partitura e letra)": liga o servidor-ia neste computador,
  // sem Docker e sem administrador (serve no notebook corporativo). A primeira vez instala tudo (uns 15 minutos).
  // Depois, se o QR code não aparecer (a rede da empresa bloqueia o túnel da Cloudflare), aba Portas →
  // Encaminhar uma porta → 7860, visibilidade Pública, e abra o endereço que aparece.
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Ligar o servidor da IA (partitura e letra)",
      "type": "process",
      "windows": { "command": "cmd.exe", "args": ["/c", "${workspaceFolder}\\servidor-ia\\iniciar-windows-sem-docker.bat"] },
      "linux": { "command": "python3.11", "args": ["${workspaceFolder}/servidor-ia/iniciar_pc.py"] },
      "osx": { "command": "python3.11", "args": ["${workspaceFolder}/servidor-ia/iniciar_pc.py"] },
      "isBackground": true,
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated", "focus": true }
    },
    {
      "label": "Ligar o servidor da IA só com as Portas do VS Code (sem Cloudflare)",
      "type": "process",
      "windows": { "command": "cmd.exe", "args": ["/c", "${workspaceFolder}\\servidor-ia\\iniciar-windows-sem-docker.bat"] },
      "linux": { "command": "python3.11", "args": ["${workspaceFolder}/servidor-ia/iniciar_pc.py"] },
      "osx": { "command": "python3.11", "args": ["${workspaceFolder}/servidor-ia/iniciar_pc.py"] },
      "options": { "env": { "IA_SEM_TUNEL": "1" } },
      "isBackground": true,
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated", "focus": true }
    }
  ]
}
