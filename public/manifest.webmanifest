{
  "id": "./",
  "name": "Songbook Litúrgico",
  "short_name": "Songbook",
  "description": "Cifras, repertórios e liturgia diária para ministérios de música",
  "start_url": "./#/",
  "scope": "./",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#000000",
  "theme_color": "#121212",
  "lang": "pt-BR",
  "categories": [
    "music",
    "lifestyle"
  ],
  "share_target": {
    "action": "./compartilhar",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "audio",
          "accept": [
            "audio/*",
            "video/mp4",
            "video/webm",
            ".mp3",
            ".m4a",
            ".wav",
            ".ogg",
            ".opus",
            ".webm",
            ".aac",
            ".flac"
          ]
        }
      ]
    }
  },
  "icons": [
    {
      "src": "icon-192-v7.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icon-512-v7.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icon-maskable-192-v7.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "icon-maskable-512-v7.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "icon.svg?v=7",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    }
  ]
}
